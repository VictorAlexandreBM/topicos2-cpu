Visit -- UC01_1
Visit -- UC08_1
Visit -- UC08_2
Visit -- UC08_3

Cliente -- UC08_4

Admin -- UC02_1
Admin -- UC02_5
Admin -- UC03_1
Admin -- UC03_5
Admin -- UC04_1
Admin -- UC04_5
Admin -- UC05_1
Admin -- UC05_5
Admin -- UC06_1
Admin -- UC06_5
Admin -- UC07_1
Admin -- UC07_5

@enduml